{
    "name": "vcian/laradar",
    "description": "Automatically discover, visualize, and document Laravel application architecture with an interactive dashboard, HTML/JSON/Markdown reports, dependency graphs, and AI-powered insights.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "architecture",
        "discovery",
        "visualization",
        "dashboard",
        "documentation",
        "dependency-graph",
        "ai",
        "code-analysis",
        "laradar"
    ],
    "authors": [
        {
            "name": "Hitesh Rudakiya",
            "email": "hitesh.rudakiya@viitor.cloud",
            "homepage": "https://viitorcloud.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/vcian/laradar",
    "support": {
        "issues": "https://github.com/vcian/laradar/issues",
        "source": "https://github.com/vcian/laradar"
    },
    "autoload": {
        "psr-4": {
            "Vcian\\Laradar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vcian\\Laradar\\LaradarServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "symfony/finder": "^5.4|^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Vcian\\Laradar\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
